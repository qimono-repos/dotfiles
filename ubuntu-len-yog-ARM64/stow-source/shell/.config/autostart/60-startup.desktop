# Stow: shell → ~/.config/autostart/60-startup.desktop
# Disabled on ubuntu-len-yog-ARM64: the AMD pack's startup-login.sh (Ghostty,
# Guix Firefox, Alpaca) is not part of this Snapdragon bootstrap yet. Flip to
# enabled once you opt those in AND add scripts/startup-login.sh to this pack.
[Desktop Entry]
Type=Application
Version=1.0
Name=Startup shell fragment (ARM64 — disabled)
Comment=Placeholder; do not autostart missing scripts
Exec=/bin/true
Terminal=false
X-GNOME-Autostart-enabled=false
