# Copy to env.local (not committed) or export in ~/.secrets
# IBM Quantum / Qiskit Runtime
# QISKIT_IBM_TOKEN=
# QISKIT_IBM_CHANNEL=ibm_quantum

# Azure Quantum
# AZURE_QUANTUM_RESOURCE_ID=
# AZURE_QUANTUM_LOCATION=

# Memory-conscious defaults for this 6.5GiB laptop
QIMONO_MAX_QUBITS_LOCAL=16
QIMONO_DEFAULT_SHOTS=1024
