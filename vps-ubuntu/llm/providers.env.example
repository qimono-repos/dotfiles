# Qimono vps-ubuntu — LLM provider keys (TEMPLATE).
#
# Copy to ~/.config/qimono/providers.env (or run scripts/configure-llm.sh,
# which creates it for you) and fill in ONLY the providers you use.
# The real file is gitignored and chmod 600. NEVER commit real keys.
#
# Generated configs reference these names via {env:VAR} / env_key, so the
# values are read at runtime — not copied into config.toml / opencode.json.

# ---- OpenAI (also enables Codex API-key mode) ------------------------------
OPENAI_API_KEY=

# ---- Anthropic (opencode) --------------------------------------------------
ANTHROPIC_API_KEY=

# ---- OpenRouter (opencode + Codex custom provider) -------------------------
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openai/gpt-6.1-sol

# ---- Google (opencode) -----------------------------------------------------
GOOGLE_GENERATIVE_AI_API_KEY=

# ---- Ollama / OpenAI-compatible local endpoint -----------------------------
# Include the /v1 suffix, e.g. http://127.0.0.1:11434/v1
OLLAMA_BASE_URL=
# OLLAMA_API_KEY=
# OLLAMA_MODEL=gemma4:e2b

# ---- Any other OpenAI-compatible endpoint (vLLM, LiteLLM, Azure proxy...) --
# Codex custom providers must speak the Responses API.
CUSTOM_BASE_URL=
# CUSTOM_API_KEY=
# CUSTOM_NAME=My endpoint
# CUSTOM_MODEL=

# ---- Optional explicit selections (usually leave blank) --------------------
# CODEX_PROVIDER=openai        # openai | openrouter | qimono_ollama | custom
# CODEX_MODEL=
# OPENCODE_MODEL=anthropic/claude-sonnet-5-5
