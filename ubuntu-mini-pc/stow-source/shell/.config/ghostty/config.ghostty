# Ghostty terminal config — qi-mini-pc-ubu-rr
# Theme: Catppuccin Mocha | Font: CaskaydiaCove Nerd Font

# ── Font ──────────────────────────────────────────────
font-family = CaskaydiaCove Nerd Font
font-family-bold = CaskaydiaCove Nerd Font Bold
font-family-italic = CaskaydiaCove Nerd Font Italic
font-family-bold-italic = CaskaydiaCove Nerd Font Bold Italic
font-size = 14
font-thicken = true

# ── Theme & Colors ────────────────────────────────────
theme = Catppuccin Mocha
background-opacity = 0.95
background-blur-radius = 20

# ── Cursor ────────────────────────────────────────────
cursor-style = bar
cursor-style-blink = true

# ── Shell ─────────────────────────────────────────────
command = /usr/bin/zsh

# ── Window ────────────────────────────────────────────
window-padding-x = 8
window-padding-y = 4
window-decoration = auto
window-save-state = always
confirm-close-surface = false

# ── Keybindings ───────────────────────────────────────
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_surface
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size
