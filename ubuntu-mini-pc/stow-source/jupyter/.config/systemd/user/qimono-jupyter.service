[Unit]
Description=Qimono local Jupyter Notebook (Guix)
Documentation=file://%h/source/repos/qimono-repos/dotfiles/ubuntu-mini-pc/docs/jupyter.md

[Service]
Type=simple
Environment=GUIX_PROFILE=%h/.guix-profile
Environment=PATH=%h/.guix-profile/bin:%h/.guix-profile/sbin:/usr/local/bin:/usr/bin:/bin
# No LD_LIBRARY_PATH: it would leak into !ls in notebooks (GLIBC_2.43).
# Guix jupyter has its own RUNPATH. Aer wheels: set env on the kernel later.
WorkingDirectory=%h/source/repos/qimono-repos/quantum-workspace
ExecStart=%h/.guix-profile/bin/jupyter notebook
KillSignal=SIGINT
TimeoutStopSec=15

[Install]
WantedBy=default.target
