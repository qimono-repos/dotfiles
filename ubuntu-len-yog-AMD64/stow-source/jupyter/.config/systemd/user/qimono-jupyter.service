[Unit]
Description=Qimono local Jupyter Notebook (Guix)
Documentation=file://%h/source/repos/qimono-repos/dotfiles/ubuntu-len-yog-AMD64/docs/quantum-computing.md

[Service]
Type=simple
# Guix user profile on PATH for this non-login unit
Environment=GUIX_PROFILE=%h/.guix-profile
Environment=PATH=%h/.guix-profile/bin:%h/.guix-profile/sbin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=%h/source/repos/qimono-repos/quantum-workspace
# Bind address/port come from ~/.jupyter/jupyter_notebook_config.py (stow)
ExecStart=%h/.guix-profile/bin/jupyter notebook
KillSignal=SIGINT
TimeoutStopSec=15

[Install]
WantedBy=default.target
